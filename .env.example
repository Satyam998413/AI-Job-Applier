# ---- AI-Job-Applier environment ----
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_job_applier

# Secret used to sign HS256 session JWTs (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# 32-byte base64 key used to encrypt user API keys at rest.
# Generate one: openssl rand -base64 32
ENCRYPTION_KEY=

# Optional: system fallback AI key. Per-user keys configured in Settings take precedence.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Legacy (unused): JSearch is now configured per-user in Settings.
RAPIDAPI_KEY=

# Public base URL of the app. Used to build the Nylas OAuth callback URL.
APP_URL=http://localhost:3000

# Nylas v3 credentials (https://dashboard.nylas.com). Optional — needed only for email features.
# Register `<APP_URL>/api/nylas/callback` in the Nylas app's "Redirect URIs".
NYLAS_API_KEY=
NYLAS_CLIENT_ID=
# Nylas region (default US). EU customers: https://api.eu.nylas.com
NYLAS_API_URI=https://api.us.nylas.com

# Sentry DSN (optional). Without it, Sentry is a no-op in both server and browser.
# DSNs are public by design, so NEXT_PUBLIC_ is safe and required for the browser bundle.
NEXT_PUBLIC_SENTRY_DSN=

# Shared secret Vercel Cron sends in `Authorization: Bearer <CRON_SECRET>`.
# Generate: openssl rand -hex 32. Without it set, /api/cron/* refuses every request.
CRON_SECRET=

# Vercel Blob token for storing AI Interview audio recordings.
# Create in Vercel dashboard → Storage → Blob. Without this set, interview media upload is disabled.
BLOB_READ_WRITE_TOKEN=

# Transcription model used by /api/interview/[id]/finish to convert audio → text.
# Reads the user's active OpenAI provider key; falls back to GEMINI if no OpenAI key.
WHISPER_MODEL=whisper-1
